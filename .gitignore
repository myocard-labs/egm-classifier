# --------------------------------------------------------------------
# Python
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# --------------------------------------------------------------------
# Virtual environments
# --------------------------------------------------------------------
.venv*/
venv/
env/
.env
.python-version

# --------------------------------------------------------------------
# Tooling caches
# --------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# --------------------------------------------------------------------
# IDE / editor
# --------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --------------------------------------------------------------------
# Notebooks (committed clean; nbstripout enforces this via pre-commit)
# --------------------------------------------------------------------
.ipynb_checkpoints/

# --------------------------------------------------------------------
# Scientific data, model artifacts, generated banks
# Never commit binary data — it bloats the repo and breaks `git clone`.
# Use external storage (HuggingFace Hub, S3, PhysioNet) instead.
# --------------------------------------------------------------------
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.ckpt
*.safetensors

# Root-anchored so these only ignore top-level generated-output dirs and do
# NOT swallow same-named source packages (e.g. src/.../data/, the training-data
# layer absorbed from egm-data in Refactor Step 8).
/data/
/banks/
/checkpoints/
/exports/
runs/
logs/
mlruns/
wandb/
artifacts/

# Allow tiny fixtures committed under tests/fixtures/ if needed:
!tests/fixtures/**

# --------------------------------------------------------------------
# Local run configs
# Scratch train/eval/export YAMLs for a specific machine + bank layout.
# Root-anchored (does not touch any src/ or tests/ subpackage). Configs
# meant to be shared ship as committed examples under examples/.
# --------------------------------------------------------------------
/configs/

# --------------------------------------------------------------------
# Build / docs
# --------------------------------------------------------------------
docs/_build/
site/
